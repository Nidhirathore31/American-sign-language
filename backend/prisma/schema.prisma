generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int          @id @default(autoincrement())
  email     String       @unique
  password  String
  name      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  testResults TestResult[]
}

model TestResult {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  total       Int      @default(10)
  percentage  Float
  results     String   // Array of {signId, signName, correct: boolean, feedback: string}
  createdAt   DateTime @default(now())
}
